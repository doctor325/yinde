  "episodes": {
    "zhang": {
      "sources": [
        "song-59",
        "song-46",
        "nan-32"
      ],
      "required": [
        "speaker",
        "reason"
      ],
      "expected": "义恭欲弃彭城南归。军粮不足是史家交代的背景。张畅说一动身人就会散，还认为现有办法可以支撑守城。"
    },
    "wang": {
      "sources": [
        "jin-122"
      ],
      "required": [
        "speaker",
        "proposal",
        "reason"
      ],
      "expected": "王穆劝张大豫不要急于逼战，指出吕光兵精、粮足、城坚。大豫进逼是史家叙述，兵粮判断是王穆的发言。"
    },
    "xin": {
      "sources": [
        "sanguozhi-25"
      ],
      "required": [
        "speaker",
        "proposal",
        "reason"
      ],
      "expected": "曹丕要把冀州士家迁往河南，辛毗劝阻。他本人说此时迁徙会失去民心，也没粮食供给。蝗灾与民饥、最终迁半数均为史家叙述。"
    },
    "wei": {
      "sources": [
        "jiutangshu-71"
      ],
      "required": [
        "speaker",
        "proposal",
        "reason"
      ],
      "expected": "魏徵反对封禅，唐太宗要求他说清楚。魏徵在答话中说各国会来，而伊洛以东至海岱仍萧条，向来使暴露虚弱。公卿请封禅是史家叙述。"
    },
    "feixian": {
      "sources": [
        "xintangshu-97"
      ],
      "required": [
        "speaker",
        "reason"
      ],
      "expected": "魏徵就修飞仙宫上疏，以隋炀帝奢侈扰民而亡为鉴，劝太宗节制营建。外国使者看到中原虚弱属于另一次封禅问答。"
    }
  },
