{"file_id":2,"header_lines":9,"total_lines":27,"start":1,"end":27,"lines":[{"no":1,"text":"# -*- mode: mandoku-view -*-","annotation":["文件头"]},{"no":2,"text":"#+PROPERTY: LICENSE MIT（演示数据，非本项目语料）","annotation":["文件头"]},{"no":3,"text":"#+TITLE: 演示樣例·甲","annotation":["文件头"]},{"no":4,"text":"#+DATE: 2026-09-11","annotation":["文件头"]},{"no":5,"text":"#+PROPERTY: ID DM1a0001","annotation":["文件头"]},{"no":6,"text":"#+PROPERTY: BASEEDITION tls","annotation":["文件头"]},{"no":7,"text":"#+PROPERTY: JUAN 2","annotation":["文件头"]},{"no":8,"text":"#+PROPERTY: CAT 演示数据（非真实史料）","annotation":["文件头"]},{"no":9,"text":"# 演示数据：本项目自撰，非 Kanripo 语料，非真实史料原文。事实取自旧闻，文字自撰。","annotation":["文件头"]},{"no":10,"text":"<pb:DM1a0001_tls_002-1a>¶","annotation":["page/structure"]},{"no":11,"text":"** 3 秦語","annotation":["heading/structure"]},{"no":12,"text":"","annotation":["空行(不入库)"]},{"no":13,"text":"<pb:DM1a0001_tls_002-2a>¶","annotation":["page/structure"]},{"no":14,"text":"秦穆公聞百里奚之賢，以五羖羊皮贖之。¶","annotation":["passage/main"]},{"no":15,"text":"穆公相百里奚，秦國大治。¶","annotation":["passage/main"]},{"no":16,"text":"<pb:DM1a0001_tls_002-3a>¶","annotation":["page/structure"]},{"no":17,"text":"","annotation":["空行(不入库)"]},{"no":18,"text":"# src: DEMO JIA 3.1; 演示資料（自撰）","annotation":["comment/structure"]},{"no":19,"text":"百里奚讓曰：臣不如蹇叔。¶","annotation":["passage/main"]},{"no":20,"text":"繆公用百里奚之謀，遂霸西戎。¶","annotation":["passage/main"]},{"no":21,"text":"秦穆公卒，葬於雍。¶","annotation":["passage/main"]},{"no":22,"text":"<pb:DM1a0001_tls_002-4a>¶","annotation":["page/structure"]},{"no":23,"text":"","annotation":["空行(不入库)"]},{"no":24,"text":"# src: DEMO JIA 3.2; 演示資料（自撰）","annotation":["comment/structure"]},{"no":25,"text":"# dating: demo-3","annotation":["·(并入上块)"]},{"no":26,"text":"管子曰：倉廩實而知禮節。¶","annotation":["passage/main"]},{"no":27,"text":"管仲之書，後人述之。¶","annotation":["passage/main"]}]}