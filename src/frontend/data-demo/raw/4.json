{"file_id":4,"header_lines":9,"total_lines":21,"start":1,"end":21,"lines":[{"no":1,"text":"# -*- mode: mandoku-view; -*-","annotation":["文件头"]},{"no":2,"text":"#+PROPERTY: LICENSE MIT（演示数据，非本项目语料）","annotation":["文件头"]},{"no":3,"text":"#+TITLE: 演示樣例·乙","annotation":["文件头"]},{"no":4,"text":"#+DATE: 2026-09-11","annotation":["文件头"]},{"no":5,"text":"#+PROPERTY: ID DM2e0001","annotation":["文件头"]},{"no":6,"text":"#+PROPERTY: BASEEDITION SBCK","annotation":["文件头"]},{"no":7,"text":"#+PROPERTY: WITNESS SBCK","annotation":["文件头"]},{"no":8,"text":"#+PROPERTY: JUAN 2","annotation":["文件头"]},{"no":9,"text":"# 演示数据：本项目自撰，非 Kanripo 语料，非真实史料原文。事实取自旧闻，文字自撰。","annotation":["文件头"]},{"no":10,"text":"<pb:DM2e0001_SBCK_002-1a>¶","annotation":["page/structure"]},{"no":11,"text":"*** 2.1　《齊語》","annotation":["heading/structure"]},{"no":12,"text":"桓公自莒反於齊(反還也/桓公小白)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]},{"no":13,"text":"使鮑叔牙為宰(鮑叔齊大夫/宰官名也)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]},{"no":14,"text":"鮑叔辭曰臣不如管夷吾(夷吾管仲名也/辭讓也)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]},{"no":15,"text":"<pb:DM2e0001_SBCK_002-1b>¶","annotation":["page/structure"]},{"no":16,"text":"桓公曰管夷吾射寡人中鉤(鉤帶鉤也/射射桓公)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]},{"no":17,"text":"鮑叔曰夫為其君動也(各為其主/動謂盡力)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]},{"no":18,"text":"君若宥而反之(宥赦也/反還也)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]},{"no":19,"text":"<pb:DM2e0001_SBCK_002-2a>¶","annotation":["page/structure"]},{"no":20,"text":"桓公乃召管仲於魯(魯國名也/召召還之)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]},{"no":21,"text":"管仲相齊四十餘年(相輔也/四十餘年久任)¶","annotation":["passage/main","passage/commentary_candidate/pending_commentary"]}]}