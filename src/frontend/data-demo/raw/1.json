{"file_id":1,"header_lines":9,"total_lines":51,"start":1,"end":51,"lines":[{"no":1,"text":"# -*- mode: mandoku-view -*-","annotation":["文件头"]},{"no":2,"text":"#+PROPERTY: LICENSE MIT（演示数据，非本项目语料）","annotation":["文件头"]},{"no":3,"text":"#+TITLE: 演示樣例·甲","annotation":["文件头"]},{"no":4,"text":"#+DATE: 2026-09-11","annotation":["文件头"]},{"no":5,"text":"#+PROPERTY: ID DM1a0001","annotation":["文件头"]},{"no":6,"text":"#+PROPERTY: BASEEDITION tls","annotation":["文件头"]},{"no":7,"text":"#+PROPERTY: JUAN 1","annotation":["文件头"]},{"no":8,"text":"#+PROPERTY: CAT 演示数据（非真实史料）","annotation":["文件头"]},{"no":9,"text":"# 演示数据：本项目自撰，非 Kanripo 语料，非真实史料原文。事实取自旧闻，文字自撰。","annotation":["文件头"]},{"no":10,"text":"<pb:DM1a0001_tls_001-1a>¶","annotation":["page/structure"]},{"no":11,"text":"** 1 齊語","annotation":["heading/structure"]},{"no":12,"text":"","annotation":["空行(不入库)"]},{"no":13,"text":"<pb:DM1a0001_tls_001-2a>¶","annotation":["page/structure"]},{"no":14,"text":"齊桓公即位，任管仲為相。¶","annotation":["passage/main"]},{"no":15,"text":"管仲相齊，作內政而寄軍令。¶","annotation":["passage/main"]},{"no":16,"text":"桓公用管仲之謀，九合諸侯，一匡天下。¶","annotation":["passage/main"]},{"no":17,"text":"<pb:DM1a0001_tls_001-3a>¶","annotation":["page/structure"]},{"no":18,"text":"","annotation":["空行(不入库)"]},{"no":19,"text":"# src: DEMO JIA 1.1; 演示資料（自撰）","annotation":["comment/structure"]},{"no":20,"text":"# dating: demo-1","annotation":["·(并入上块)"]},{"no":21,"text":"齊桓公問於管仲曰：何以安國？¶","annotation":["passage/main"]},{"no":22,"text":"管仲對曰：修舊法，擇其善者而業用之。¶","annotation":["passage/main"]},{"no":23,"text":"<pb:DM1a0001_tls_001-4a>¶","annotation":["page/structure"]},{"no":24,"text":"","annotation":["空行(不入库)"]},{"no":25,"text":"# src: DEMO JIA 1.2; 演示資料（自撰）","annotation":["comment/structure"]},{"no":26,"text":"管仲病，桓公問誰可代者。¶","annotation":["passage/main"]},{"no":27,"text":"管仲卒，齊桓公失其輔。¶","annotation":["passage/main"]},{"no":28,"text":"桓公卒，五公子爭立，齊國大亂。¶","annotation":["passage/main"]},{"no":29,"text":"<pb:DM1a0001_tls_001-5a>¶","annotation":["page/structure"]},{"no":30,"text":"","annotation":["空行(不入库)"]},{"no":31,"text":"** 2 晉語","annotation":["heading/structure"]},{"no":32,"text":"","annotation":["空行(不入库)"]},{"no":33,"text":"<pb:DM1a0001_tls_001-6a>¶","annotation":["page/structure"]},{"no":34,"text":"*** 2.1　《晉公子重耳》","annotation":["heading/structure"]},{"no":35,"text":"晉公子重耳出亡，奔狄。¶","annotation":["passage/main"]},{"no":36,"text":"重耳出亡十九年，而後得入。¶","annotation":["passage/main"]},{"no":37,"text":"重耳過衛，衛不禮焉。¶","annotation":["passage/main"]},{"no":38,"text":"<pb:DM1a0001_tls_001-7a>¶","annotation":["page/structure"]},{"no":39,"text":"","annotation":["空行(不入库)"]},{"no":40,"text":"# src: DEMO JIA 2.1; 演示資料（自撰）","annotation":["comment/structure"]},{"no":41,"text":"# dating: demo-2","annotation":["·(并入上块)"]},{"no":42,"text":"*** 2.2　《晉文公》","annotation":["heading/structure"]},{"no":43,"text":"晉文公即位，賞從亡者。¶","annotation":["passage/main"]},{"no":44,"text":"文公修政，施惠百姓。¶","annotation":["passage/main"]},{"no":45,"text":"文公入國，秦穆公之力也。¶","annotation":["passage/main"]},{"no":46,"text":"<pb:DM1a0001_tls_001-8a>¶","annotation":["page/structure"]},{"no":47,"text":"","annotation":["空行(不入库)"]},{"no":48,"text":"# src: DEMO JIA 2.2; 演示資料（自撰）","annotation":["comment/structure"]},{"no":49,"text":"晉文公與楚人戰於城濮。¶","annotation":["passage/main"]},{"no":50,"text":"城濮之戰，晉侯敗楚師。¶","annotation":["passage/main"]},{"no":51,"text":"晉文公卒，子襄公立。¶","annotation":["passage/main"]}]}